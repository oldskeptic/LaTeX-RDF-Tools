\RDFReference@termCacheSlot=0
\RDFReference@termCacheSize=0
\RDFReference@termCacheHits=0
\RDFReference@termCacheLimit=32

% Retain only the most recent term results. This avoids rereading cache files
% for common repeated references without keeping records for every ontology.
\def\RDFReference@termCacheLookup#1#2#3#4{%
  \RDFReference@termCacheHitfalse
  \RDFReference@termCacheSearchSlot=1
  \loop\ifnum\RDFReference@termCacheSearchSlot<\numexpr\RDFReference@termCacheLimit+1\relax
    \ifcsname RDFReference@termCachePrefix@\the\RDFReference@termCacheSearchSlot\endcsname
      \IfEq{#1}{\csname RDFReference@termCachePrefix@\the\RDFReference@termCacheSearchSlot\endcsname}{%
        \IfEq{#2}{\csname RDFReference@termCacheTerm@\the\RDFReference@termCacheSearchSlot\endcsname}{%
          \IfEq{#3}{\csname RDFReference@termCacheKind@\the\RDFReference@termCacheSearchSlot\endcsname}{%
            \IfEq{#4}{\csname RDFReference@termCacheLanguage@\the\RDFReference@termCacheSearchSlot\endcsname}{%
              \expandafter\let\expandafter\RDFReference@cacheValue
                \csname RDFReference@termCacheValue@\the\RDFReference@termCacheSearchSlot\endcsname
              \RDFReference@termCacheHitSlot=\RDFReference@termCacheSearchSlot
              \RDFReference@termCacheHittrue
              \global\advance\RDFReference@termCacheHits by 1\relax
            }{}%
          }{}%
        }{}%
      }{}%
    \fi
    \advance\RDFReference@termCacheSearchSlot by 1\relax
  \repeat
}

\def\RDFReference@termCacheStore#1#2#3#4#5{%
  \global\advance\RDFReference@termCacheSlot by 1\relax
  \ifnum\RDFReference@termCacheSlot>\RDFReference@termCacheLimit
    \global\RDFReference@termCacheSlot=1
  \fi
  \RDFReference@termCacheClearSupers
  \ifnum\RDFReference@termCacheSize<\RDFReference@termCacheLimit
    \global\advance\RDFReference@termCacheSize by 1\relax
  \fi
  \expandafter\protected@xdef
    \csname RDFReference@termCachePrefix@\the\RDFReference@termCacheSlot\endcsname{#1}%
  \expandafter\protected@xdef
    \csname RDFReference@termCacheTerm@\the\RDFReference@termCacheSlot\endcsname{#2}%
  \expandafter\protected@xdef
    \csname RDFReference@termCacheKind@\the\RDFReference@termCacheSlot\endcsname{#3}%
  \expandafter\protected@xdef
    \csname RDFReference@termCacheLanguage@\the\RDFReference@termCacheSlot\endcsname{#4}%
  \expandafter\global\expandafter\let
    \csname RDFReference@termCacheValue@\the\RDFReference@termCacheSlot\endcsname#5%
}

\def\RDFReference@emptyCacheValue{}
\def\RDFReference@superFoundMarker{found}
\def\RDFReference@superMissingMarker{missing}

\def\RDFReference@termCacheClearSupers{%
  \ifcsname RDFReference@termCacheSuperCount@\the\RDFReference@termCacheSlot\endcsname
    \@tempcnta=\csname RDFReference@termCacheSuperCount@\the\RDFReference@termCacheSlot\endcsname\relax
    \@tempcntb=1\relax
    \@whilenum\@tempcntb<\numexpr\@tempcnta+1\relax\do{%
      \expandafter\gdef
        \csname RDFReference@termCacheSuperItem@\the\RDFReference@termCacheSlot @\the\@tempcntb\endcsname{}%
      \advance\@tempcntb by 1\relax
    }%
    \expandafter\gdef
      \csname RDFReference@termCacheSuperCount@\the\RDFReference@termCacheSlot\endcsname{0}%
  \fi
}

\def\RDFReference@termCacheSuperStore{%
  \expandafter\xdef
    \csname RDFReference@termCacheSuperCount@\the\RDFReference@termCacheSlot\endcsname
    {\the\RDFReference@superTotal}%
  \RDFReference@superPosition=1\relax
  \@whilenum\RDFReference@superPosition<\numexpr\RDFReference@superTotal+1\relax\do{%
    \expandafter\let\expandafter\RDFReference@cacheTemp
      \csname RDFReference@superItem@\the\RDFReference@superPosition\endcsname
    \expandafter\global\expandafter\let
      \csname RDFReference@termCacheSuperItem@\the\RDFReference@termCacheSlot @\the\RDFReference@superPosition\endcsname
      \RDFReference@cacheTemp
    \advance\RDFReference@superPosition by 1\relax
  }%
}

\def\RDFReference@termCacheSuperRestore{%
  \@tempcnta=\csname RDFReference@termCacheSuperCount@\the\RDFReference@termCacheHitSlot\endcsname\relax
  \RDFReference@superTotal=\@tempcnta
  \RDFReference@superPosition=1\relax
  \@whilenum\RDFReference@superPosition<\numexpr\RDFReference@superTotal+1\relax\do{%
    \expandafter\let\expandafter\RDFReference@cacheTemp
      \csname RDFReference@termCacheSuperItem@\the\RDFReference@termCacheHitSlot @\the\RDFReference@superPosition\endcsname
    \expandafter\global\expandafter\let
      \csname RDFReference@superItem@\the\RDFReference@superPosition\endcsname
      \RDFReference@cacheTemp
    \advance\RDFReference@superPosition by 1\relax
  }%
}

