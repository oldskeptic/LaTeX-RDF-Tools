\newcommand{\rdfaddtolist}{%
  \ifx\rdffragmentlisttitle\@empty
    \ifx\rdffragmenttitle\@empty
      \ifrdffragmentdirect
        \def\rdffragmentlisttitle{Direct RDF listing}%
      \else
        \def\rdffragmentlisttitle{Imported RDF fragment}%
      \fi
    \else
      \edef\rdffragmentlisttitle{\rdffragmenttitle}%
    \fi
  \fi
  \addcontentsline{rdfl}{rdfFragment}{%
    \protect\numberline{\therdfFragment}\rdffragmentlisttitle
  }%
}

\newcommand{\rdfheadingtitle}{%
  \ifx\rdffragmenttitle\@empty
    \rdfname~\therdfFragment
  \else
    \rdfname~\therdfFragment: \rdffragmenttitle
  \fi
}

\newcommand{\rdffragmentsourcepath}{%
  \edef\rdffragment@sourcepath{\noexpand\path{\rdffragmentsource}}%
  \rdffragment@sourcepath
}

\def\rdffragment@directbegin{%
  \rdflistingheading{%
    \rdfheadingtitle
    \ifrdfformatoverride
      \space--- \rdfformatname
    \else
      \ifx\rdffragmenttitle\@empty
        \ifx\rdffragmentdirectcaption\@empty
          \space--- \rdfformatname
        \fi
      \fi
    \fi
  }%
  \ifx\rdffragmentdirectcaption\@empty
  \else
    \rdffragment@caption@plain{\rdffragmentdirectcaption}%
  \fi
  \ifx\rdffragmentlabel\@empty
  \else
    \label{\rdffragmentlabel}%
  \fi
  \VerbatimEnvironment
  \begin{Verbatim}[
    fontsize=\small,
    frame=single,
    framesep=4pt,
    rulecolor=\color{rdfframe},
    numbers=left,
    numbersep=8pt,
    xleftmargin=2.2em,
    formatcom=\rdffragment@formatcom
  ]%
}

\def\rdffragment@sourcebegin{%
  \let\rdffragment@originalcaption\caption
  \renewcommand{\caption}{\rdffragment@caption}%
}

\newenvironment{rdfFragment}[1][]{%
  \begingroup
  \def\rdffragmentsource{}%
  \def\rdffragmenttitle{}%
  \def\rdffragmentcaption{}%
  \def\rdffragmentlisttitle{}%
  \def\rdffragmentlabel{}%
  \def\rdffragmentdirectcaption{}%
  \def\rdfformatname{Direct RDF listing}%
  \rdfshowsourcefalse
  \rdfnoprefixfalse
  \rdfformatoverridefalse
  \setkeys{rdffragment}{#1}%
  \refstepcounter{rdfFragment}%
  \ifx\rdffragmentsource\@empty
    \rdffragmentdirecttrue
    \let\rdffragment@begin\rdffragment@directbegin
  \else
    \rdffragmentdirectfalse
    \let\rdffragment@begin\rdffragment@sourcebegin
  \fi
  \rdffragment@begin
}{%
  \ifrdffragmentdirect
    \end{Verbatim}%
    \par\medskip
  \else
    \IfFileExists{\rdffragmentsource}{%
      \ifrdfformatoverride
      \else
        \rdfformatbyextension{\rdffragmentsource}%
      \fi
      \rdflistingheading{\rdfheadingtitle\space--- detected as \rdfformatname}%
      \ifrdfshowsource
        \noindent{\small\color{rdfmuted}\textit{Source: }\rdffragmentsourcepath}%
        \par\smallskip
      \fi
      \rdffragmentinput{\rdffragmentsource}%
      \par\medskip
    }{%
      \PackageError{RDFTools}{RDF/OWL file `\rdffragmentsource' not found}%
        {Check the source option passed to the rdfFragment environment.}%
    }%
  \fi
  \rdfaddtolist
  \endgroup
}

