  \let\RDFReference@originalBibliography\bibliography
  \def\bibliography#1{%
    \IfEq{\RDFReference@bibFiles}{}{%
      \RDFReference@originalBibliography{#1}%
    }{%
      \edef\RDFReference@bibliographyArgument{%
        #1,\RDFReference@bibFiles%
