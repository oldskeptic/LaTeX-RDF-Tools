  \ifRDFReference@shellEscape
    \RDFReference@queueSource{#1}{#2}%
    \expandafter\xdef\csname RDFReference@cachePath@#1\endcsname{%
      rdfCache/\jobname.rdfref.#1.tex}%
    \ifcsname RDFReference@sourceRegistered@#1\endcsname
    \else
      \expandafter\gdef\csname RDFReference@sourceRegistered@#1\endcsname{1}%
      \g@addto@macro\RDFReference@cacheChecks{%
        \RDFReference@checkPreparedSource{#1}%
      }%
      \g@addto@macro\RDFReference@sources{%
        \RDFReference@prepareSource{#1}%
      }%
    \fi
    \IfEq{\RDFReference@glossaryMode}{none}{}{%
      \RequirePackage{RDFTools-glossaries}%
    }%
    \expandafter\xdef\csname RDFReference@glossaryMode@#1\endcsname{%
      \RDFReference@glossaryMode}%
    \expandafter\gdef\csname RDFReference@source@#1\endcsname{#2}%
    \ifRDFReference@indexTerms
      \expandafter\gdef\csname RDFReference@indexEnabled@#1\endcsname{1}%
    \else
      \expandafter\gdef\csname RDFReference@indexEnabled@#1\endcsname{0}%
    \fi
    \RDFReference@registerBibFile{rdfCache/\jobname.rdfref.#1.bib}%
  \else
    \PackageError{RDFTools}{Unrestricted shell escape is required by \string\useRDF}{%
      Enable shell escape for this trusted document. For PDFLaTeX, XeLaTeX,
      or LuaLaTeX, pass -shell-escape; for Tectonic, pass -Z shell-escape.}%
  \fi
}

\newcommand{\citeBibo}[2]{%
  \RDFReference@resetStreamSelectors
  \def\RDFReference@bibPrefix{#1}%
  \def\RDFReference@bibTerm{#2}%
  \def\RDFReference@bibResult{}%
  \RDFReference@termCacheLookup{#1}{#2}{bib}{}%
  \ifRDFReference@termCacheHit
    \let\RDFReference@bibResult\RDFReference@cacheValue
  \else
    \RDFReference@scanSource{#1}%
    \ifx\RDFReference@bibResult\@empty
    \else
      \RDFReference@termCacheStore{#1}{#2}{bib}{}\RDFReference@bibResult
    \fi
  \fi
  \ifx\RDFReference@bibResult\@empty
    \PackageWarning{RDFTools}{No BIBO bibliographic resource found for
      term `#2' in prefix `#1'}%
    \texttt{Undefined}%
  \else
    \@ifpackageloaded{biblatex}{}{%
      \@ifpackageloaded{natbib}{}{%
        \PackageWarning{RDFTools}{No biblatex or natbib package detected;
          using the classic BibTeX citation interface}%
      }%
    }%
    \cite{\RDFReference@bibResult}%
  \fi
}

\newcommand{\RDFTermName}[1]{%
  \RDFReference@termArguments{\RDFReference@termName}{#1}%
}

\def\RDFReference@termName#1#2{%
  \RDFReference@ifnextbracket{\RDFReference@name@optional{#1}{#2}}{%
    \RDFReference@lookup{#1}{#2}{name}{}%
  }%
}

\def\RDFReference@name@optional#1#2[#3]{%
  \RDFReference@ifnextbracket{\RDFReference@name@region{#1}{#2}{#3}}{%
    \RDFReference@lookup{#1}{#2}{name}{#3}%
  }%
}

\def\RDFReference@name@region#1#2#3[#4]{%
  \RDFReference@lookup{#1}{#2}{name}{#3-#4}%
}

\def\RDFReference@renderSuperTerm#1{%
  \RDFTermName{\RDFReference@superRenderPrefix}{#1}%
}

\def\RDFReference@warnUnknownHierarchyTerm#1#2{%
  \PackageWarning{RDFTools}{Unknown term `#2' in prefix `#1'}%
}

\newcommand{\RDFListSuper}[1]{%
  \RDFReference@termArguments{%
    \RDFReference@listSuper{direct}}{#1}%
}

\newcommand{\RDFListSuperTransitive}[1]{%
  \RDFReference@termArguments{%
    \RDFReference@listSuper{transitive}}{#1}%
}

\def\RDFReference@listSuper#1#2#3{%
  \RDFReference@glossaryUse{#2}{#3}%
  \RDFReference@resetStreamSelectors
  \def\RDFReference@superPrefix{#2}%
  \def\RDFReference@superTerm{#3}%
  \def\RDFReference@superRenderPrefix{#2}%
  \def\RDFReference@directMode{direct}%
  \def\RDFReference@currentSuperMode{#1}%
  \ifx\RDFReference@directMode\RDFReference@currentSuperMode
    \RDFReference@directSuperOnlytrue
  \else
    \RDFReference@directSuperOnlyfalse
  \fi
  \RDFReference@superTotal=0\relax
  \RDFReference@termCacheLookup{#2}{#3}{hierarchy-#1}{}%
  \ifRDFReference@termCacheHit
    \RDFReference@termCacheSuperRestore
    \ifx\RDFReference@cacheValue\RDFReference@superMissingMarker
      \RDFReference@warnUnknownHierarchyTerm{#2}{#3}%
    \fi
  \else
    % URI records distinguish an unknown resource from a valid term with no
    % parent relationships; both cases otherwise produce an empty list.
    \def\RDFReference@lookupPrefix{#2}%
    \def\RDFReference@lookupTerm{#3}%
    \def\RDFReference@uriResult{}%
    \RDFReference@scanSource{#2}%
    \ifx\RDFReference@uriResult\@empty
      \RDFReference@warnUnknownHierarchyTerm{#2}{#3}%
      \RDFReference@termCacheStore{#2}{#3}{hierarchy-#1}{}%
        \RDFReference@superMissingMarker
    \else
      \RDFReference@termCacheStore{#2}{#3}{hierarchy-#1}{}%
        \RDFReference@superFoundMarker
    \fi
    \RDFReference@termCacheSuperStore
  \fi
  \RDFReference@superPosition=1\relax
  \@whilenum\RDFReference@superPosition<\numexpr\RDFReference@superTotal+1\relax\do{%
    \ifnum\RDFReference@superPosition>1\relax
      \ifnum\RDFReference@superPosition=\RDFReference@superTotal
        \space and\space
      \else
        ,\space
      \fi
    \fi
    \expandafter\RDFReference@renderSuperTerm\expandafter{%
      \csname RDFReference@superItem@\the\RDFReference@superPosition\endcsname
    }%
    \advance\RDFReference@superPosition by 1\relax
  }%
}

\newcommand{\RDFTermDefinition}[1]{%
  \RDFReference@termArguments{\RDFReference@termDefinition}{#1}%
}

\def\RDFReference@termDefinition#1#2{%
  \RDFReference@ifnextbracket{\RDFReference@definition@optional{#1}{#2}}{%
    \RDFReference@lookup{#1}{#2}{definition}{}%
  }%
}

\def\RDFReference@definition@optional#1#2[#3]{%
  \RDFReference@ifnextbracket{\RDFReference@definition@region{#1}{#2}{#3}}{%
    \RDFReference@lookup{#1}{#2}{definition}{#3}%
  }%
}

\def\RDFReference@definition@region#1#2#3[#4]{%
  \RDFReference@lookup{#1}{#2}{definition}{#3-#4}%
}

\def\RDFReferenceIndexEntry#1#2#3{%
  \@ifnextchar[{\RDFReferenceIndexEntry@withAnchor{#1}{#2}{#3}}{%
    \RDFReferenceIndexEntry@render{#1}{#2}{#3}{}%
  }%
}

\def\RDFReferenceIndexEntry@withAnchor#1#2#3[#4]{%
  \RDFReferenceIndexEntry@render{#1}{#2}{#3}{#4}%
}

\def\RDFReferenceIndexEntry@render#1#2#3#4{%
  \RDFReference@indexHasEntriestrue
  \item[\texttt{#1}] \texttt{#2}, %
  \IfEq{#4}{}{%
    page~#3%
  }{%
    \hyperlink{#4}{page~#3}%
  }\par
}

\newcommand{\makeRDFIndex}{%
  \clearpage
  \section*{RDF Term Index}%
  \addcontentsline{toc}{section}{RDF Term Index}%
  \IfFileExists{rdfCache/\jobname.rdfidx}{%
    \RDFReference@indexHasEntriesfalse
    \begin{description}
      \InputIfFileExists{rdfCache/\jobname.rdfidx}{}{}%
      \ifRDFReference@indexHasEntries
      \else
        \item[No indexed terms.] No terms have been referenced from a source
        registered with \texttt{indexTerms}.\par
      \fi
    \end{description}%
  }{%
    \noindent The RDF term index will be populated after the next compilation
    pass.\par
  }%
}

\AtEndPreamble{%
  \ifRDFReference@sourcesQueued
    \IfFileExists{RDFTools.lua}{%
      \immediate\write18{%
        texlua "$(kpsewhich --format=tex RDFTools.lua)" prepare-sources
        --sources-hex "\RDFReference@sourceHex"
        --cache-prefix "rdfCache/\jobname.rdfref."
        --warnings "rdfCache/\jobname.rdfwarn.tex"%
      }%
      \RDFReference@cacheChecks
      \IfFileExists{rdfCache/\jobname.rdfwarn.tex}{%
        \RDFReference@warningOnlytrue
        \RDFReference@inputCache{rdfCache/\jobname.rdfwarn.tex}%
        \RDFReference@warningOnlyfalse
      }{}%
    }{%
      \PackageError{RDFTools}{RDFTools.lua helper not found}{%
        Install RDFTools.lua on the TeX input path beside RDFTools.sty.}%
    }%
  \fi
}

\AtBeginDocument{%
  \IfFileExists{RDFTools.lua}{%
    \immediate\write18{%
      texlua "$(kpsewhich --format=tex RDFTools.lua)" init-index
      --output "rdfCache/\jobname.rdfidx.new"%
    }%
    \RDFReference@indexOpentrue
  }{}%
}

\AtEndDocument{%
  \ifRDFReference@indexOpen
    \IfFileExists{RDFTools.lua}{%
      \immediate\write18{%
        texlua "$(kpsewhich --format=tex RDFTools.lua)" sort-index
        --input "rdfCache/\jobname.rdfidx.new"
        --output "rdfCache/\jobname.rdfidx"%
      }%
    }{}%
    \RDFReference@indexOpenfalse
  \fi
}

\makeatother
