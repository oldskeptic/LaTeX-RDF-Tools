% Inspect a small prefix of a file when its extension is not informative.
\def\rdfformatcheckline#1{%
  \IfSubStr{#1}{<rdf:RDF}{\rdfxmltrue}{}%
  \IfSubStr{#1}{xmlns:rdf}{\rdfxmltrue}{}%
  \IfSubStr{#1}{<owl:Ontology}{\rdfxmltrue}{}%
  \IfSubStr{#1}{<?xml}{\rdfxmltrue}{}%
  \IfSubStr{#1}{@prefix}{\rdfturtletrue}{}%
  \IfSubStr{#1}{@base}{\rdfturtletrue}{}%
  \IfSubStr{#1}{PREFIX }{\rdfturtletrue}{}%
  \IfSubStr{#1}{BASE }{\rdfturtletrue}{}%
  \IfSubStr{#1}{@forAll}{\rdfnthreetrue}{}%
  \IfSubStr{#1}{@forSome}{\rdfnthreetrue}{}%
  \IfSubStr{#1}{=>}{\rdfnthreetrue}{}%
  \IfSubStr{#1}{=>>}{\rdfnthreetrue}{}%
  \IfSubStr{#1}{GRAPH }{\rdfquadstrue}{}%
  \IfSubStr{#1}{\{}{\rdfquadstrue}{}%
}

\def\rdfformatscan{%
  \ifnum\rdfscanlinecount<20
    \ifeof\rdffile
    \else
      \read\rdffile to \rdffirstline
      \advance\rdfscanlinecount by 1
      \rdfformatcheckline{\rdffirstline}%
      \rdfformatscan
    \fi
  \fi
}

\def\rdfformatbycontent#1{%
  \rdfxmlfalse
  \rdfturtlefalse
  \rdfnthreefalse
  \rdfquadsfalse
  \openin\rdffile=#1\relax
  \rdfscanlinecount=0
  \rdffileext=%
  \rdffirstline=%
  \rdffileext=%
  \rdfformatscan
  \closein\rdffile
  \ifrdfxml
    \def\rdfformatname{RDF/XML (RDF or OWL)}%
  \else\ifrdfquads
    \def\rdfformatname{N-Quads}%
  \else\ifrdfnthree
    \def\rdfformatname{N3}%
  \else\ifrdfturtle
    \def\rdfformatname{Turtle}%
  \else
    \def\rdfformatname{Unknown serialization}%
  \fi\fi\fi\fi
}

\def\rdfformatbyextension#1{%
  \filename@parse{#1}%
  \edef\rdffileext{\filename@ext}%
  \def\rdfttl{ttl}%
  \def\rdfrdf{rdf}%
  \def\rdfxmlfile{xml}%
  \def\rdfowl{owl}%
  \def\rdfnthreefile{n3}%
  \def\rdfnq{nq}%
  \def\rdfnquads{nquads}%
  \ifx\rdffileext\rdfttl
    \def\rdfformatname{Turtle}%
  \else\ifx\rdffileext\rdfrdf
    \def\rdfformatname{RDF/XML (RDF or OWL)}%
  \else\ifx\rdffileext\rdfxmlfile
    \def\rdfformatname{RDF/XML (RDF or OWL)}%
  \else\ifx\rdffileext\rdfowl
    \def\rdfformatname{RDF/XML (RDF or OWL)}%
  \else\ifx\rdffileext\rdfnthreefile
    \def\rdfformatname{N3}%
  \else\ifx\rdffileext\rdfnq
    \def\rdfformatname{N-Quads}%
  \else\ifx\rdffileext\rdfnquads
    \def\rdfformatname{N-Quads}%
  \else
    \rdfformatbycontent{#1}%
  \fi\fi\fi\fi\fi\fi\fi
}

