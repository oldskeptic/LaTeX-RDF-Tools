\newcommand{\rdflistingheading}[1]{%
  \par\medskip
  \noindent
  \setlength{\fboxsep}{7pt}%
  \color{rdfheading}%
  \textbf{#1}%
  \par\smallskip
}

\newenvironment{rdflisting}[1][RDF fragment]{%
  \rdflistingheading{#1}%
  \VerbatimEnvironment
  \renewcommand{\theFancyVerbLine}{%
    \textcolor{rdfmuted}{\scriptsize\arabic{FancyVerbLine}}%
  }%
  \begin{Verbatim}[
    fontsize=\small,
    frame=single,
    framesep=4pt,
    rulecolor=\color{rdfframe},
    numbers=left,
    numbersep=8pt,
    xleftmargin=2.2em,
    formatcom=\color{black}
  ]%
}{%
  \end{Verbatim}
  \par\medskip
}

\newcommand{\rdffragmentinput}[1]{%
  \renewcommand{\theFancyVerbLine}{%
    \textcolor{rdfmuted}{\scriptsize\arabic{FancyVerbLine}}%
  }%
  \VerbatimInput[
    fontsize=\small,
    frame=single,
    framesep=4pt,
    rulecolor=\color{rdfframe},
    numbers=left,
    numbersep=8pt,
    xleftmargin=2.2em,
    formatcom=\rdffragment@formatcom
  ]{#1}%
}

\def\rdffragment@formatcom{%
  \rdffragment@filterprefixhook
  \color{black}%
}

\ExplSyntaxOn
\tl_new:N \l__rdf_fragment_line_tl
\bool_new:N \l__rdf_fragment_prefix_bool
\bool_new:N \l__rdf_fragment_turtle_prefix_bool
\cs_new_protected:Npn \rdffragment@resetprefixfilter
  { \bool_set_false:N \l__rdf_fragment_prefix_bool }
\cs_new_protected:Npn \rdffragment@filterprefixline
  {
    % Expand the line container once, never the active verbatim characters.
    \tl_set:Nx \l__rdf_fragment_line_tl
      { \exp_args:No \tl_to_str:n { \FV@Line } }
    \regex_match:nVTF { \A \s* @prefix \s } \l__rdf_fragment_line_tl
      {
        \bool_set_true:N \l__rdf_fragment_prefix_bool
        \bool_set_true:N \l__rdf_fragment_turtle_prefix_bool
      }
      {
        \regex_match:nVT { \A \s* [Pp][Rr][Ee][Ff][Ii][Xx] \s } \l__rdf_fragment_line_tl
          {
            \bool_set_true:N \l__rdf_fragment_prefix_bool
            \bool_set_false:N \l__rdf_fragment_turtle_prefix_bool
          }
      }
    \bool_if:NTF \l__rdf_fragment_prefix_bool
      {
        % Keep original source line numbers, but do not render declarations.
        \global\advance\FV@CodeLineNo\@ne
        \bool_if:NTF \l__rdf_fragment_turtle_prefix_bool
          {
            \regex_match:nVT { \. \s* (\x{23} .* )? \Z } \l__rdf_fragment_line_tl
              { \bool_set_false:N \l__rdf_fragment_prefix_bool }
          }
          {
            \regex_match:nVT { > } \l__rdf_fragment_line_tl
              { \bool_set_false:N \l__rdf_fragment_prefix_bool }
          }
      }
      { \rdffragment@originalpreprocessline }
  }
\cs_generate_variant:Nn \regex_match:nnTF { nV }
\cs_generate_variant:Nn \regex_match:nnT { nV }
\ExplSyntaxOff

\def\rdffragment@filterprefixhook{%
  \ifrdfnoprefix
    \rdffragment@resetprefixfilter
    \let\rdffragment@originalpreprocessline\FV@PreProcessLine
    \let\FV@PreProcessLine\rdffragment@filterprefixline
  \fi
}

